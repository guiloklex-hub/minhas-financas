generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  avatarUrl String?

  // 2FA (TOTP)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Recuperação de senha
  resetToken        String?
  resetTokenExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id             String   @id @default(uuid())
  name           String
  type           String   // "CHECKING", "CREDIT", "CASH"
  initialBalance Float    @default(0)
  currency       String   @default("BRL")

  transactions   Transaction[]
  recurringRules RecurringRule[]
  goals          Goal[]

  // Cartões que usam esta conta como pagamento padrão da fatura.
  creditCards    CreditCard[] @relation("CardPaymentAccount")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Category {
  id           String  @id @default(uuid())
  name         String
  color        String?
  icon         String?
  sortOrder    Int     @default(0)

  transactions           Transaction[]
  budgets                Budget[]
  recurringRules         RecurringRule[]
  creditCardTransactions CreditCardTransaction[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Budget {
  id          String   @id @default(uuid())
  amountLimit Float
  month       Int
  year        Int
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id         String   @id @default(uuid())
  title      String
  amount     Float
  type       String   // "INCOME" ou "EXPENSE"
  date       DateTime

  notes      String?
  tags       String?  // lista separada por vírgula
  reconciled Boolean  @default(false)

  isTransfer        Boolean @default(false)
  transferGroupId   String?
  recurrenceGroupId String?

  // Quando esta transação é o pagamento de uma fatura de cartão (EXPENSE +
  // isTransfer=true na conta pagadora), aponta para a fatura quitada.
  creditCardInvoiceId String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
  @@index([accountId])
  @@index([categoryId])
}

model AiUsageLog {
  id               String   @id @default(uuid())
  feature          String
  status           String
  errorMessage     String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())
}

model Investment {
  id            String    @id @default(uuid())
  name          String
  type          String    // "FIXED_INCOME", "VARIABLE_INCOME", "CRYPTO"
  initialAmount Float
  currentAmount Float
  yieldRate     Float     // Taxa anual, ex: 0.105 para 10.5%
  startDate     DateTime
  maturityDate  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Regra de recorrência: o cron diário gera Transaction quando nextRunDate <= hoje.
model RecurringRule {
  id          String    @id @default(uuid())
  title       String
  amount      Float
  type        String    // "INCOME" | "EXPENSE"
  frequency   String    // "WEEKLY" | "MONTHLY" | "YEARLY"
  dayOfMonth  Int?      // usado em MONTHLY/YEARLY (com clamp de fim de mês)
  nextRunDate DateTime
  lastRunDate DateTime?
  isActive    Boolean   @default(true)

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Meta financeira (ex.: reserva de emergência).
model Goal {
  id            String    @id @default(uuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notificação in-app (sino).
model Notification {
  id        String   @id @default(uuid())
  title     String
  body      String
  url       String?
  type      String   @default("INFO") // INFO | WARNING | SUCCESS | DANGER
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

// Inscrição de Web Push (VAPID), multi-dispositivo.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Trilha de auditoria de ações sensíveis.
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Resumo mensal gerado proativamente pela IA (persistido).
model MonthlyInsight {
  id        String   @id @default(uuid())
  month     Int
  year      Int
  summary   String
  payload   String?  // JSON com as métricas que embasaram o resumo
  createdAt DateTime @default(now())

  @@unique([month, year])
}

// Cotação de câmbio (multi-moeda). Alimentada manualmente ou por fonte externa.
model ExchangeRate {
  id    String   @id @default(uuid())
  base  String   // ex.: "USD"
  quote String   // ex.: "BRL"
  rate  Float
  date  DateTime @default(now())

  @@unique([base, quote, date])
}

// Cartão de crédito (entidade separada das contas). O saldo devido é derivado
// das CreditCardTransaction; faturas são materializadas por competência.
model CreditCard {
  id          String  @id @default(uuid())
  name        String
  brand       String? // VISA | MASTERCARD | ELO | AMEX | HIPERCARD | OTHER
  lastFour    String?
  color       String?
  creditLimit Float   @default(0)
  closingDay  Int     // dia de fechamento da fatura (1-31, com clamp)
  dueDay      Int     // dia de vencimento da fatura (1-31, com clamp)
  currency    String  @default("BRL")

  // Conta padrão usada para pagar a fatura.
  paymentAccountId String?
  paymentAccount   Account? @relation("CardPaymentAccount", fields: [paymentAccountId], references: [id])

  rewardType String @default("NONE") // NONE | CASHBACK | POINTS | MILES
  rewardRate Float  @default(0)      // pontos/cashback por unidade gasta
  annualFee  Float  @default(0)

  archived Boolean @default(false)

  transactions CreditCardTransaction[]
  invoices     CreditCardInvoice[]
  rewards      CardRewardLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lançamento do cartão. Compras parceladas geram uma linha por parcela,
// agrupadas por installmentGroupId, cada uma datada na sua competência.
model CreditCardTransaction {
  id       String   @id @default(uuid())
  cardId   String
  card     CreditCard @relation(fields: [cardId], references: [id])
  title    String
  amount   Float    // valor desta parcela (na moeda do cartão)
  date     DateTime // data da compra (origem da competência)
  type     String   @default("PURCHASE") // PURCHASE | REFUND | FEE | INTEREST | ADJUSTMENT

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  notes String?
  tags  String?

  // Parcelamento
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  // Fatura (competência) a que pertence
  invoiceId String?
  invoice   CreditCardInvoice? @relation(fields: [invoiceId], references: [id])

  // Compra internacional (snapshot)
  fxCurrency String?
  fxAmount   Float?
  iofAmount  Float?

  rewardPoints Float @default(0)

  isSubscription    Boolean @default(false)
  recurrenceGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([date])
  @@index([invoiceId])
}

// Fatura por competência. totalAmount é snapshot no fechamento.
model CreditCardInvoice {
  id            String   @id @default(uuid())
  cardId        String
  card          CreditCard @relation(fields: [cardId], references: [id])
  referenceMonth Int
  referenceYear  Int
  closingDate   DateTime
  dueDate       DateTime
  status        String   @default("OPEN") // OPEN | CLOSED | PAID | PARTIAL | OVERDUE
  totalAmount   Float    @default(0)
  paidAmount    Float    @default(0)
  paymentGroupId String?

  items CreditCardTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardId, referenceMonth, referenceYear])
}

// Ledger imutável de recompensas (pontos/cashback/milhas).
model CardRewardLedger {
  id            String   @id @default(uuid())
  cardId        String
  card          CreditCard @relation(fields: [cardId], references: [id])
  transactionId String?
  type          String   // EARN | REDEEM | EXPIRE | ADJUST
  points        Float
  balanceAfter  Float
  description   String?
  createdAt     DateTime @default(now())

  @@index([cardId])
}
