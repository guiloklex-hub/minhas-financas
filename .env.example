# Configurações do Banco de Dados (SQLite local)
DATABASE_URL="file:./prisma/dev.db"

# Segredo usado para assinar/verificar os tokens JWT de sessão.
# Gere um valor aleatório forte (ex.: `openssl rand -base64 48`).
# Obrigatório em produção; sem ele a aplicação não inicia.
JWT_SECRET="troque-por-um-segredo-aleatorio-forte"

# Google Gemini API (Para IA e Insights Mágicos)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua-chave-aqui"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Teto mensal de gasto com IA em USD (guardrail). Vazio = sem limite.
AI_MONTHLY_BUDGET_USD="5"

# Cron jobs (recorrências, alertas, limpeza). Header: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET="troque-por-um-segredo-de-cron"

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
# Sem essas chaves, o push é simplesmente ignorado (no-op).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"
# A chave pública também precisa ficar disponível no client:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# E-mail (SMTP) para alertas — sem isso, o envio é ignorado (no-op).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
NOTIFY_EMAIL_TO=""

# Multi-moeda: fonte externa de câmbio (AwesomeAPI). Sem isso, use cotações manuais.
# Endpoint /last com os pares desejados (base-BRL). Sem chave necessária.
EXCHANGE_RATE_API_URL="https://economia.awesomeapi.com.br/last/USD-BRL,EUR-BRL,GBP-BRL"

# URL base pública da app (usada no link de recuperação de senha quando não há
# header de origem). Ex.: https://financas.seudominio.com
APP_URL="http://localhost:3000"

# Open Banking (agregador BR — ex.: Pluggy). Requer conta no provedor.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
